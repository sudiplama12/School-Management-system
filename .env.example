# Where the browser sends API calls.
#
# Leave this unset (or commented out) when running `npm run dev`: Vite's dev proxy
# forwards /api and /uploads to http://localhost:5000, so a relative path just works.
#
# Set it to the full backend URL when building for a host that serves the frontend
# and the API separately, e.g. on Render:
#   VITE_API_URL=https://backend-smart-lms.onrender.com/api
#
# Vite reads these while *building*, not at runtime, so changing this on Render needs
# a new deploy of the frontend — not just a restart.
VITE_API_URL=
